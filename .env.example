# Ruta del repositorio heset (por defecto ../heset al ejecutar sin Docker)
# HESET_REPO_PATH=../heset

# Autor cuyos commits se usan (por defecto user.email del repositorio)
HESET_AUTHOR_EMAIL=
HESET_AUTHOR_NAME=

# Servicio compatible con OpenAI. Sin llave se usan borradores automáticos.
HESET_LLM_API_KEY=
HESET_LLM_BASE_URL=https://api.openai.com/v1
HESET_LLM_MODEL=gpt-4o-mini

# Ejemplo para Gemini (Google AI Studio):
# HESET_LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# HESET_LLM_MODEL=gemini-3.5-flash-lite
